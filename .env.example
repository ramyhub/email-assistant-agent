# Enter your Microsoft Entra application credentials here, never your mailbox password.
MAIL_EMAIL=YOUR_NETID@illinois.edu
MS_CLIENT_ID=YOUR_MICROSOFT_APPLICATION_CLIENT_ID
MS_TENANT_ID=organizations
POLL_SECONDS=300
# Optional comma-separated filters
MAIL_SENDERS=
MAIL_KEYWORDS=
STATE_DIR=.state

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional WhatsApp Cloud API channel. Leave all blank to disable it.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALLOWED_SENDER=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_WEBHOOK_PORT=8766
